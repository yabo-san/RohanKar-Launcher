{
  "name": "y4bo-launcher",
  "version": "1.6.0-fork.13",
  "description": "y4bo game launcher",
  "author": "Kilted-Kraken",
  "main": "src/electron/main.js",
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "test": "node --test",
    "test:coverage": "node --test --test-reporter=spec --experimental-test-coverage --test-coverage-include='src/backend/**' --test-coverage-include=src/frontend/sources.js --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80",
    "test:e2e": "playwright test",
    "build": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0"
  },
  "dependencies": {
    "axios": "^1.0.0",
    "better-sqlite3": "^12.6.2",
    "electron-updater": "^6.3.9",
    "extract-zip": "^2.0.1"
  },
  "build": {
    "appId": "com.rohankar.launcher",
    "productName": "y4bo",
    "files": [
      "src/**/*",
      "assets/**/*",
      "overrides.json",
      "catalog/uploaders.json",
      "catalog/collisions.json",
      "catalog/featured.json",
      "catalog/banners.json"
    ],
    "extraResources": [
      {
        "from": "assets/heroes",
        "to": "heroes"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/rk-logo.ico"
    },
    "nsis": {
      "guid": "2bb8c09d-2711-598b-90f1-e9685ecdb3dc",
      "artifactName": "y4bo-Setup-${version}.${ext}"
    },
    "mac": {
      "icon": "assets/icons/rk-logo.icns"
    },
    "linux": {
      "icon": "assets/icons/rk-logo.png"
    },
    "detectUpdateChannel": false,
    "publish": {
      "provider": "generic",
      "url": "https://yabo-san.github.io/RohanKar-Launcher/stable/"
    }
  }
}
